# VITE_GEMINI_API_KEY: powers the real conversational replies in the Cisco
# chat widget (src/lib/aiChat.ts) for anything its local rules don't
# recognize. Without this, that fallback still works, it just returns one
# fixed line instead of a generated one. Get a free key at
# https://aistudio.google.com/apikey, then add it here and in Vercel.
#
# NOTE: this used to be documented as plain GEMINI_API_KEY (no VITE_ prefix),
# left over from this project's original AI-Studio scaffold, where the
# platform injected it under that name automatically. On Vite, only
# VITE_-prefixed variables are exposed to client code at all, so a key saved
# under the old name is silently never read, exactly as if no key were set.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin login (change in production; access admin at your-site-url#admin)
VITE_ADMIN_EMAIL="admin@joetech.shop"
VITE_ADMIN_PASSWORD="ChangeMe@2026"

# EmailJS Configuration (for visitor sign-in email alerts)
VITE_EMAILJS_SERVICE_ID="your_service_id"
VITE_EMAILJS_TEMPLATE_ID="your_template_id"
VITE_EMAILJS_PUBLIC_KEY="your_public_key"
